{
  "version": 8,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-x64",
      "displayName": "Windows x64",
      "description": "Build Bacons Helper for 64-bit OBS Studio on Windows. Run scripts/package-windows.ps1 to bootstrap OBS/Qt automatically.",
      "binaryDir": "${sourceDir}/build_x64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "generator": "Visual Studio 17 2022",
      "architecture": "x64,version=10.0.22621",
      "cacheVariables": {
        "CMAKE_PREFIX_PATH": "$env{BH_OBS_CMAKE_PREFIX_PATH}",
        "libobs_DIR": "$env{BH_OBS_LIBOBS_DIR}",
        "obs-frontend-api_DIR": "$env{BH_OBS_FRONTEND_DIR}",
        "Qt6_DIR": "$env{BH_OBS_QT6_DIR}"
      }
    },
    {
      "name": "ubuntu-x86_64",
      "displayName": "Ubuntu/Linux x86_64",
      "description": "Build Bacons Helper against distro-provided OBS/Qt/libsecret development packages.",
      "binaryDir": "${sourceDir}/build_x86_64",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_LIBDIR": "lib/x86_64-linux-gnu"
      }
    },
    {
      "name": "flatpak-x86_64",
      "displayName": "Flatpak extension x86_64",
      "description": "Build inside the com.obsproject.Studio Flatpak SDK.",
      "binaryDir": "${sourceDir}/build_flatpak",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_INSTALL_LIBDIR": "lib",
        "CMAKE_INSTALL_DATADIR": "share"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-x64",
      "configurePreset": "windows-x64",
      "configuration": "RelWithDebInfo"
    },
    {
      "name": "ubuntu-x86_64",
      "configurePreset": "ubuntu-x86_64"
    },
    {
      "name": "flatpak-x86_64",
      "configurePreset": "flatpak-x86_64"
    }
  ]
}
