include_guard(GLOBAL)

if(APPLE)
    set(_bh_default_layout LEGACY)
else()
    set(_bh_default_layout BUNDLE)
endif()
set(BH_OBS_INSTALL_LAYOUT "${_bh_default_layout}" CACHE STRING "OBS installation layout: BUNDLE, SYSTEM, FLATPAK, or LEGACY")
set_property(CACHE BH_OBS_INSTALL_LAYOUT PROPERTY STRINGS BUNDLE SYSTEM FLATPAK LEGACY)

function(bh_install_plugin target data_directory)
    if(NOT BH_OBS_INSTALL_LAYOUT MATCHES "^(BUNDLE|SYSTEM|FLATPAK|LEGACY)$")
        message(FATAL_ERROR "Unknown BH_OBS_INSTALL_LAYOUT: ${BH_OBS_INSTALL_LAYOUT}")
    endif()
    if(WIN32)
        set(BH_MANIFEST_OS_ARCH windows-x64)
    elseif(APPLE)
        set(BH_MANIFEST_OS_ARCH macos-${CMAKE_SYSTEM_PROCESSOR})
    else()
        set(BH_MANIFEST_OS_ARCH linux-${CMAKE_SYSTEM_PROCESSOR})
    endif()

    if(APPLE)
        # macOS is outside the release matrix; keep its previous source layout.
        set(binary_destination obs-plugins)
        set(data_destination share/obs/obs-plugins/bacons-helper)
    elseif(BH_OBS_INSTALL_LAYOUT STREQUAL "BUNDLE")
        # OBS 33 third-party bundle, rooted at ProgramData/plugins, portable
        # OBS/plugins, or XDG_DATA_HOME/obs-studio/plugins.
        set(binary_destination bacons-helper)
        set(data_destination bacons-helper/data)
    elseif(WIN32 AND BH_OBS_INSTALL_LAYOUT STREQUAL "LEGACY")
        set(binary_destination obs-plugins/64bit)
        set(data_destination data/obs-plugins/bacons-helper)
    elseif(WIN32)
        message(FATAL_ERROR "SYSTEM and FLATPAK layouts are Linux-only")
    else()
        include(GNUInstallDirs)
        if(BH_OBS_INSTALL_LAYOUT STREQUAL "LEGACY")
            set(binary_destination ${CMAKE_INSTALL_LIBDIR}/obs-plugins)
            set(data_destination ${CMAKE_INSTALL_DATADIR}/obs/obs-plugins/bacons-helper)
        else()
            # System OBS 33 paths; also used by Flatpak's plugin merge dirs.
            set(binary_destination ${CMAKE_INSTALL_LIBDIR}/obs-modules/plugins)
            set(data_destination ${CMAKE_INSTALL_DATADIR}/obs/obs-modules/plugins/bacons-helper)
        endif()
    endif()

    configure_file("${CMAKE_CURRENT_FUNCTION_LIST_DIR}/plugin-manifest.json.in"
        "${CMAKE_CURRENT_BINARY_DIR}/plugin-manager/manifest.json" @ONLY)
    install(TARGETS ${target} LIBRARY DESTINATION "${binary_destination}")
    install(DIRECTORY "${data_directory}/" DESTINATION "${data_destination}")
    install(FILES "${CMAKE_CURRENT_BINARY_DIR}/plugin-manager/manifest.json" DESTINATION "${data_destination}")
    message(STATUS "OBS plugin layout: ${BH_OBS_INSTALL_LAYOUT}; module=${binary_destination}; data=${data_destination}")
endfunction()
